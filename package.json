{
  "name": "playwright-studio",
  "version": "0.1.0",
  "description": "A local visual test builder for Playwright",
  "author": "Playwright Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "package": "electron-builder --mac --win"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "playwright": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "typescript": "latest",
    "concurrently": "latest",
    "wait-on": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest"
  },
  "build": {
    "appId": "com.playwrightstudio.app",
    "productName": "Playwright Studio",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" }
  }
}
